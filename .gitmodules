[submodule "extlib/tlx"]
	path = extlib/tlx
	url = https://github.com/tlx/tlx.git
[submodule "extlib/fmt"]
	path = extlib/fmt
	url = https://github.com/fmtlib/fmt.git
[submodule "extlib/modular_arithmetic"]
	path = extlib/modular_arithmetic
	url = https://github.com/hurchalla/modular_arithmetic.git
[submodule "extlib/rk-lce"]
	path = extlib/rk-lce
	url = https://github.com/nicolaprezza/rk-lce.git
[submodule "extlib/parallel-hashmap"]
	path = extlib/parallel-hashmap
	url = https://github.com/greg7mdp/parallel-hashmap.git
[submodule "extlib/PGM-index"]
	path = extlib/PGM-index
	url = https://github.com/gvinciguerra/PGM-index.git
[submodule "extlib/ips4o"]
	path = extlib/ips4o
	url = https://github.com/ips4o/ips4o.git
[submodule "extlib/la_vector"]
	path = extlib/la_vector
	url = https://github.com/gvinciguerra/la_vector.git
[submodule "extlib/libsais"]
	path = extlib/libsais
	url = https://github.com/IlyaGrebnov/libsais.git
[submodule "extlib/gsaca-double-sort"]
	path = extlib/gsaca-double-sort
	url = https://github.com/jonas-ellert/gsaca-double-sort.git
	branch = gsaca-for-lce
[submodule "extlib/malloc_count"]
	path = extlib/malloc_count
	url = https://github.com/ByteHamster-etc/malloc_count.git
	branch = aligned_alloc
